---
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  title: string;
  excerpt: string;
  href: string;
  image?: string;
  video?: string;
  gallery?: string[];
}
const { title, excerpt, href, image, video, gallery } = Astro.props;
---
<div class="bg-surface border border-border rounded-brand overflow-hidden transition-shadow duration-150 hover:shadow-[0_10px_24px_rgba(20,40,90,0.08)]">
  <ProjectMedia title={title} image={image} video={video} gallery={gallery} />
  <div class="p-5 px-[1.3rem]">
    <a href={href} class="hover:text-accent transition-colors">
      <h3 class="text-[1.05rem] mb-1.5 text-navy">{title}</h3>
    </a>
    <p class="text-sm mb-2.5">{excerpt}</p>
    <a href={href} class="text-sm font-semibold text-accent">Leer historia →</a>
  </div>
</div>
