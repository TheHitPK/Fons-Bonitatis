---
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  title: string;
  excerpt: string;
  href: string;
  image?: string;
  video?: string;
  gallery?: string[];
  linkText?: string;
}
const { title, excerpt, href, image, video, gallery, linkText = 'Leer historia' } = Astro.props;
---
<div class="card-media group">
  <ProjectMedia title={title} image={image} video={video} gallery={gallery} />
  <div class="p-5 px-[1.3rem]">
    <a href={href} class="hover:text-accent transition-colors">
      <h3 class="text-[1.05rem] mb-1.5 text-navy">{title}</h3>
    </a>
    <p class="text-sm mb-2.5">{excerpt}</p>
    <a href={href} class="text-sm font-semibold text-accent underline decoration-accent/0 decoration-2 underline-offset-4 hover:decoration-accent/100 transition-[text-decoration-color]">{linkText}</a>
  </div>
</div>
