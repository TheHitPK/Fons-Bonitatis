---
interface Props {
  label?: string;
}
const { label = 'Trabajamos junto a' } = Astro.props;

const partners = [
  { name: 'Cáritas Venezuela', logo: '/images/partners/caritas.webp', width: 400, height: 400 },
  { name: 'Fundación Cambiando Vidas', logo: '/images/partners/cambiando-vidas.webp', width: 352, height: 352 },
  { name: 'Universidad del Zulia', logo: '/images/partners/luz.webp', width: 253, height: 320 },
  { name: 'Hermanas de la Caridad de Santa Ana', logo: '/images/partners/logo-hermanas-caridad-santa-ana.webp', width: 296, height: 122 },
  { name: 'The Papal Foundation', logo: '/images/partners/papal-foundation.webp', width: 526, height: 384 },
  { name: 'Unión Europea', logo: '/images/partners/logotipo-union-europea-ilustracion-vectorial-icono-bandera-ue-estrellas-redondas_118339-1616.avif', width: 400, height: 400 }
];
---
<section class="py-10 bg-surface border-y border-border">
  <div class="container">
    <p class="text-center text-xs uppercase tracking-wider font-bold text-body-muted mb-6">{label}</p>
    <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {partners.map((partner, i) => (
        <img
          src={partner.logo}
          alt={partner.name}
          title={partner.name}
          width={partner.width}
          height={partner.height}
          class="h-32 w-auto max-w-[140px] object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all"
          data-aos="zoom-in"
          data-aos-delay={i * 80}
        />
      ))}
    </div>
  </div>
</section>
