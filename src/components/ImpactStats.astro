---
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats?: Stat[];
}
const {
  stats = [
    { value: '+3.200', label: 'Pacientes atendidos' },
    { value: '+180', label: 'Cirugías gratuitas' },
    { value: '12', label: 'Años de labor' },
    { value: '+40', label: 'Jornadas médicas' }
  ]
} = Astro.props;
---
<section class="py-10">
  <div class="container grid grid-cols-2 sm:grid-cols-4 gap-4">
    {stats.map((stat, i) => {
      const match = stat.value.match(/^(\D*)([\d.,]+)(\D*)$/);
      const [, prefix, numStr, suffix] = match ?? ['', '', stat.value, ''];
      const target = parseInt(numStr.replace(/[.,]/g, ''), 10);
      return (
        <div
          class="card text-center"
          data-aos="fade-up"
          data-aos-delay={i * 100}
        >
          <p class="font-heading text-[2rem] text-navy m-0">
            {Number.isFinite(target) ? (
              <span class="stat-number" data-target={target} data-prefix={prefix} data-suffix={suffix}>{prefix}0{suffix}</span>
            ) : (
              <span>{stat.value}</span>
            )}
          </p>
          <p class="text-sm text-body-muted mt-1 mb-0">{stat.label}</p>
        </div>
      );
    })}
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.target);
    const prefix = el.dataset.prefix ?? '';
    const suffix = el.dataset.suffix ?? '';
    if (prefersReducedMotion || !Number.isFinite(target)) {
      el.textContent = `${prefix}${target.toLocaleString('es-VE')}${suffix}`;
      return;
    }
    const duration = 1400;
    let startTime: number | null = null;
    function step(timestamp: number) {
      if (startTime === null) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(target * eased);
      el.textContent = `${prefix}${current.toLocaleString('es-VE')}${suffix}`;
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const statNumbers = document.querySelectorAll<HTMLElement>('.stat-number');
  if (statNumbers.length && !document.body.dataset.statsObserverBound) {
    document.body.dataset.statsObserverBound = 'true';
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });
    statNumbers.forEach((el) => observer.observe(el));
  }
</script>
