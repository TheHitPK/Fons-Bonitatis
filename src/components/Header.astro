---
import { navItems } from '../data/nav.js';

const locale = Astro.currentLocale ?? 'es';

const donateLabel = locale === 'en' ? 'Donate now' : 'Donar ahora';
const donateHref = locale === 'en' ? '/en/contactos' : '/contactos';

const pathname = Astro.url.pathname;
const esHref = locale === 'en' ? (pathname.replace(/^\/en/, '') || '/') : pathname;
const enHref = locale === 'en' ? pathname : `/en${pathname}`;
---
<header class="sticky top-0 z-50 bg-white border-b border-border">
  <div class="container flex items-center justify-between gap-6 py-3.5">
    <a href="/" class="flex items-center">
      <img src="/images/general/fbf1.webp" alt="Fons Bonitatis Foundation" class="h-12 w-auto" width="500" height="206" />
    </a>
    <nav class="hidden md:flex gap-7 text-sm font-semibold text-navy">
      {navItems.map(item => (
        <a href={locale === 'en' ? `/en${item.href}` : item.href} class="hover:text-accent transition-colors">{locale === 'en' ? item.en : item.es}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-1.5 text-xs font-bold">
        <a href={esHref} class={locale === 'es' ? 'text-navy' : 'text-body-muted hover:text-navy transition-colors'}>ES</a>
        <span class="text-border">|</span>
        <a href={enHref} class={locale === 'en' ? 'text-navy' : 'text-body-muted hover:text-navy transition-colors'}>EN</a>
      </div>
      <a href={donateHref} class="btn btn-primary whitespace-nowrap">{donateLabel}</a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden relative w-9 h-9 flex items-center justify-center text-navy shrink-0"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menú</span>
        <span id="menu-icon-bars" class="absolute transition-all duration-300 ease-out opacity-100 scale-100 rotate-0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-6 h-6">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </span>
        <span id="menu-icon-close" class="absolute transition-all duration-300 ease-out opacity-0 scale-50 -rotate-90">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-6 h-6">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden absolute top-full left-0 right-0 bg-white border-b border-border shadow-lg origin-top transition-all duration-300 ease-out opacity-0 scale-y-95 -translate-y-1 pointer-events-none"
  >
    <nav class="container flex flex-col py-4 gap-1 text-sm font-semibold text-navy">
      {navItems.map(item => (
        <a href={locale === 'en' ? `/en${item.href}` : item.href} class="py-2.5 border-b border-border last:border-0 hover:text-accent transition-colors">{locale === 'en' ? item.en : item.es}</a>
      ))}
      <div class="flex items-center gap-1.5 text-xs font-bold pt-3">
        <a href={esHref} class={locale === 'es' ? 'text-navy' : 'text-body-muted'}>ES</a>
        <span class="text-border">|</span>
        <a href={enHref} class={locale === 'en' ? 'text-navy' : 'text-body-muted'}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');

  if (toggle && toggle.dataset.bound !== 'true') {
    toggle.dataset.bound = 'true';

    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menu?.classList.remove('opacity-0', 'scale-y-95', '-translate-y-1', 'pointer-events-none');
      menu?.classList.add('opacity-100', 'scale-y-100', 'translate-y-0', 'pointer-events-auto');
      iconBars?.classList.remove('opacity-100', 'scale-100', 'rotate-0');
      iconBars?.classList.add('opacity-0', 'scale-50', 'rotate-90');
      iconClose?.classList.remove('opacity-0', 'scale-50', '-rotate-90');
      iconClose?.classList.add('opacity-100', 'scale-100', 'rotate-0');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
    }

    function closeMenu() {
      isOpen = false;
      menu?.classList.remove('opacity-100', 'scale-y-100', 'translate-y-0', 'pointer-events-auto');
      menu?.classList.add('opacity-0', 'scale-y-95', '-translate-y-1', 'pointer-events-none');
      iconClose?.classList.remove('opacity-100', 'scale-100', 'rotate-0');
      iconClose?.classList.add('opacity-0', 'scale-50', '-rotate-90');
      iconBars?.classList.remove('opacity-0', 'scale-50', 'rotate-90');
      iconBars?.classList.add('opacity-100', 'scale-100', 'rotate-0');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú');
    }

    toggle.addEventListener('click', () => {
      if (isOpen) closeMenu(); else openMenu();
    });

    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>
