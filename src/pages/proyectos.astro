---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import CtaBanner from '../components/CtaBanner.astro';

const projects = [
  {
    title: 'Bendición de la Unidad de Infusión Oncológica',
    excerpt: 'Bendición de los espacios de la Unidad de Infusión Oncológica del Hospital Madre Rafols, por parte de Mons. Alberto Ortega Martín, Nuncio Apostólico en Venezuela, y de Mons. José Luis Azuaje Ayala, Arzobispo Metropolitano de Maracaibo. Agradecemos el solidario e invaluable aporte de The Papal Foundation y al Papa Francisco por esta donación en favor de la salud de nuestros pacientes.',
    video: '/images/general-2/video/VID-20241123-WA0037.mp4'
  },
  {
    title: 'Embajada de la República Federal de Alemania visita el Hospital Madre Rafols',
    excerpt: 'Agradecemos a la Misión Diplomática alemana por su invaluable aporte en el desarrollo y crecimiento de la institución, del sistema de salud local, además de la salud de nuestros usuarios y pacientes.',
    gallery: [
      '/images/general-2/2023/IMG-20231201-WA0026.jpg',
      '/images/general-2/2023/IMG-20231201-WA0027.jpg',
      '/images/general-2/2023/IMG-20231201-WA0028.jpg',
      '/images/general-2/2023/IMG-20231201-WA0029.jpg',
      '/images/general-2/2023/IMG-20231201-WA0031.jpg',
      '/images/general-2/2023/IMG-20231201-WA0033.jpg'
    ]
  },
  {
    title: 'Madre Rafols inaugura su Unidad de Cuidados Intensivos',
    excerpt: 'Una nueva UCI amplía nuestra capacidad de atender emergencias y casos críticos con tecnología de primer nivel para la región.',
    video: '/images/general-2/video/317514635_3443025252599812_4586236264297397112_n.mp4'
  },
  {
    title: 'Proyecto apoyado por la Unión Europea',
    excerpt: 'A través de este proyecto, respaldado por la Unión Europea, llevamos insumos y atención humanitaria a nuestro personal y pacientes.',
    video: '/images/general-2/video/videop.mp4'
  }
];
---
<BaseLayout title="Proyectos Aprobados" description="Proyectos e iniciativas respaldadas por aliados institucionales de Fons Bonitatis Foundation." ogImage="/images/general/A10.png">
  <PageHero
    image="/images/general/A10.png"
    alt="Interior arquitectónico del Sistema de Salud Madre Rafols"
    label="Proyectos aprobados"
    title="Alianzas que hacen posible cada avance"
    lead="Cada proyecto es posible gracias a organizaciones e instituciones que confían en nuestro trabajo y se suman a la misión de llevar salud digna a Venezuela."
  />

  <section class="section">
    <div class="container grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project, i) => (
        <article class="bg-surface border border-border rounded-brand overflow-hidden" data-aos="fade-up" data-aos-delay={(i % 2) * 120}>
          <ProjectMedia title={project.title} video={project.video} gallery={project.gallery} />
          <div class="p-6">
            <h3 class="text-lg mb-2 text-navy">{project.title}</h3>
            <p class="text-sm mb-0">{project.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBanner
    title="¿Quieres aliarte con nosotros?"
    text="Buscamos organizaciones e instituciones que quieran sumarse a nuestros proyectos de salud, educación e investigación."
    buttonText="Contáctanos"
    buttonHref="/contactos"
  />
</BaseLayout>
