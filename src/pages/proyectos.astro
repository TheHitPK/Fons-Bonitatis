---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';

const projects = [
  {
    image: '/images/general/foto.png',
    title: 'Bendición de la Unidad de Infusión Oncológica',
    excerpt: 'Con el apoyo de The Papal Foundation, inauguramos y bendecimos los nuevos espacios para el tratamiento de pacientes oncológicos, agradeciendo la generosidad del Papa Francisco hacia nuestros pacientes.'
  },
  {
    image: '/images/general/hmr.png',
    title: 'Embajada de la República Federal de Alemania visita el Hospital Madre Rafols',
    excerpt: 'La misión diplomática alemana reconoció el desarrollo y crecimiento de la institución, fruto de años de trabajo conjunto e inversión sostenida.'
  },
  {
    image: '/images/general/vision11.png',
    title: 'Madre Rafols inaugura su Unidad de Cuidados Intensivos',
    excerpt: 'Una nueva UCI amplía nuestra capacidad de atender emergencias y casos críticos con tecnología de primer nivel para la región.'
  },
  {
    image: '/images/general/euro1.jpg',
    title: 'Proyecto apoyado por la Unión Europea',
    excerpt: 'A través del Proyecto Europana, en alianza con Cáritas Venezuela y Cáritas Alemania, llevamos insumos y atención humanitaria a nuestro personal y pacientes.'
  }
];
---
<BaseLayout title="Proyectos Aprobados" description="Proyectos e iniciativas respaldadas por aliados institucionales de Fons Bonitatis Foundation.">
  <PageHero
    image="/images/general/A10.png"
    alt="Interior arquitectónico del Sistema de Salud Madre Rafols"
    label="Proyectos aprobados"
    title="Alianzas que hacen posible cada avance"
    lead="Cada proyecto es posible gracias a organizaciones e instituciones que confían en nuestro trabajo y se suman a la misión de llevar salud digna a Venezuela."
  />

  <section class="section">
    <div class="container grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map(project => (
        <article class="bg-surface border border-border rounded-brand overflow-hidden">
          <img src={project.image} alt="" class="w-full aspect-[16/10] object-cover" />
          <div class="p-6">
            <h3 class="text-lg mb-2 text-navy">{project.title}</h3>
            <p class="text-sm mb-0">{project.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBanner
    title="¿Quieres aliarte con nosotros?"
    text="Buscamos organizaciones e instituciones que quieran sumarse a nuestros proyectos de salud, educación e investigación."
    buttonText="Contáctanos"
    buttonHref="/contactos"
  />
</BaseLayout>
