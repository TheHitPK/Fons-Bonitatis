---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Contactos" description="Cómo contactar a Fons Bonitatis Foundation en Maracaibo, Venezuela.">
  <PageHero
    image="/images/general/hmr.png"
    alt="Fachada del Sistema de Salud Madre Rafols al atardecer"
    label="Contactos"
    title="Hablemos"
    lead="Escríbenos o visítanos. Con gusto resolveremos tus preguntas sobre donaciones, alianzas o nuestros programas de salud."
  />

  <section class="section">
    <div class="container grid grid-cols-1 md:grid-cols-2 gap-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-surface border border-border rounded-brand p-6">
          <h3 class="text-lg mb-2">Dirección</h3>
          <p class="text-sm mb-0">Avenida Francisco de Miranda<br />Circunvalación 2, Maracaibo<br />Venezuela, Estado Zulia</p>
        </div>
        <div class="bg-surface border border-border rounded-brand p-6">
          <h3 class="text-lg mb-2">Correo</h3>
          <p class="text-sm mb-0"><a href="mailto:contacto@fonsbonitatis.org" class="text-accent font-semibold">contacto@fonsbonitatis.org</a></p>
        </div>
        <div class="bg-surface border border-border rounded-brand p-6">
          <h3 class="text-lg mb-2">Teléfono</h3>
          <p class="text-sm mb-0"><a href="tel:+12089910930" class="text-accent font-semibold">+1 (208) 991-0930</a></p>
        </div>
        <div class="bg-surface border border-border rounded-brand p-6">
          <h3 class="text-lg mb-2">Donaciones</h3>
          <p class="text-sm mb-0"><a href="/donar" class="text-accent font-semibold">Quiero donar →</a></p>
        </div>
      </div>
      <div class="rounded-brand border border-border min-h-[320px] bg-surface flex flex-col items-center justify-center text-center p-8 gap-4">
        <h3 class="text-lg mb-0">Visítanos en Maracaibo</h3>
        <p class="text-sm mb-0 max-w-[320px]">Avenida Francisco de Miranda, Circunvalación 2, Maracaibo, Venezuela, Estado Zulia.</p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Avenida+Francisco+de+Miranda+Circunvalacion+2+Maracaibo+Venezuela"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >Ver en Google Maps</a>
      </div>
    </div>
  </section>
</BaseLayout>
