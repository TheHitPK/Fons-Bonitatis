---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ImpactStats from '../../components/ImpactStats.astro';
import PartnersStrip from '../../components/PartnersStrip.astro';
import StoryCard from '../../components/StoryCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const stats = [
  { value: '+3,200', label: 'Patients treated' },
  { value: '+180', label: 'Free surgeries' },
  { value: '12', label: 'Years of service' },
  { value: '+40', label: 'Medical outreach days' }
];

import { stories as allStories } from '../../data/stories.js';

const storySlugs = [
  'madre-rafols-atendio-430-pacientes-en-el-municipio-jesus-enr',
  'madre-rafols-y-las-hermanas-de-la-caridad-de-santa-ana-brind',
  'gracias-zulia-gracias-maracaibo'
];
const storyTranslations = {
  'madre-rafols-atendio-430-pacientes-en-el-municipio-jesus-enr': {
    title: '430 patients treated in Jesús Enrique Lossada Municipality',
    excerpt: 'Through our "Madre Rafols va a tu Parroquia" outreach program, we brought free healthcare to an entire rural community.'
  },
  'madre-rafols-y-las-hermanas-de-la-caridad-de-santa-ana-brind': {
    title: '632 people treated in Los Ángeles del Tokuko',
    excerpt: 'Alongside the Sisters of Charity of Santa Ana, we brought free medical care to the Yukpa and Barí indigenous communities.'
  },
  'gracias-zulia-gracias-maracaibo': {
    title: 'Thank you, Zulia! Thank you, Maracaibo!',
    excerpt: '20 tons of humanitarian aid collected and organized for families affected by the earthquake.'
  }
};
const stories = storySlugs
  .map(slug => allStories.find(s => s.slug === slug))
  .filter((story): story is NonNullable<typeof story> => Boolean(story))
  .map(story => ({
    ...story,
    title: storyTranslations[story.slug as keyof typeof storyTranslations].title,
    excerpt: storyTranslations[story.slug as keyof typeof storyTranslations].excerpt,
    href: `/en/historias#${story.slug}`,
    linkText: 'Read story →'
  }));
---
<BaseLayout title="Healthcare in Maracaibo, Venezuela" description="Fons Bonitatis Foundation is a health foundation in Maracaibo, Zulia State, Venezuela, providing free medical care to vulnerable families.">
  <Hero
    label="Sistema de Salud Madre Rafols"
    title="Health, hope and dignity for those who need it most"
    lead="We bring free medical care to vulnerable families in Venezuela. Every donation becomes a surgery, a treatment, or a transformed life."
    primaryCtaText="Donate now"
    primaryCtaHref="/en/contactos"
    secondaryCtaText="See our work"
    secondaryCtaHref="/en/trabajo"
  />
  <ImpactStats stats={stats} />
  <PartnersStrip label="In partnership with" />

  <section class="section">
    <div class="container">
      <span class="section-label">Impact stories</span>
      <h2>Every story is a transformed life</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
        {stories.map(story => <StoryCard {...story} />)}
      </div>
    </div>
  </section>

  <CtaBanner
    label="Transparency"
    title="You know exactly where your donation goes"
    text="Every contribution goes directly to surgeries, treatments, medication, and medical outreach days for the most vulnerable families in Zulia."
    buttonText="Learn about our mission"
    buttonHref="/en/fundacion"
    buttonVariant="secondary"
  />
</BaseLayout>
