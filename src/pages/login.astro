---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Iniciar sesión" description="Acceso administrativo de Fons Bonitatis Foundation." noindex>
  <section class="section flex items-center justify-center min-h-[70vh]">
    <div class="container max-w-[420px]">
      <div class="bg-surface border border-border rounded-brand p-8">
        <div class="flex justify-center mb-6">
          <img src="/images/general/fbf1.webp" alt="Fons Bonitatis Foundation" class="h-10 w-auto" />
        </div>
        <h1 class="text-center text-2xl mb-1">Iniciar sesión</h1>
        <p class="text-center text-sm mb-6">Acceso administrativo para el equipo de la fundación.</p>

        <form class="flex flex-col gap-4">
          <div>
            <label for="email" class="block text-sm font-semibold text-navy mb-1.5">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tucorreo@fonsbonitatis.org"
              class="w-full px-4 py-2.5 rounded-lg border border-border text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
            />
          </div>
          <div>
            <label for="password" class="block text-sm font-semibold text-navy mb-1.5">Contraseña</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••••"
              class="w-full px-4 py-2.5 rounded-lg border border-border text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
            />
          </div>
          <button type="submit" class="btn btn-primary justify-center w-full mt-2">Entrar</button>
        </form>

        <p class="text-center text-sm mt-6 mb-0">
          <a href="/contactos" class="text-accent font-semibold">¿Olvidaste tu contraseña?</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
